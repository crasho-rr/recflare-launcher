#include <winres.h>
#include "resource.h"

IDI_APP ICON "../res/icon.ico"
IDR_LOGO RCDATA "../res/logo.png"
IDR_LOADER RCDATA "../build/2026loader.dll"
IDR_PATCH RCDATA "../payload/2026patch.dll"
IDR_INI RCDATA "../payload/2026patch.ini"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RecFlare"
            VALUE "FileDescription", "RecFlare Launcher"
            VALUE "FileVersion", "1.0.1"
            VALUE "InternalName", "RecFlare Launcher"
            VALUE "OriginalFilename", "RecFlare Launcher.exe"
            VALUE "ProductName", "RecFlare Launcher"
            VALUE "ProductVersion", "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
